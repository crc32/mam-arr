# ── MyAnonamouse ─────────────────────────────────────────────────────────────
MAM_COOKIE=your_mam_cookie_here
MAM_BASE=https://www.myanonamouse.net

# Optional: separate IP/ASN-locked session for dynamic seedbox updates
# Create in MAM → Preferences → Security (not your browser session cookie)
# MAM_DYNAMIC_SEEDBOX_COOKIE=your_locked_api_session_here
MAM_SEEDBOX_BASE=https://t.myanonamouse.net

# ── qBittorrent (remote seedbox supported) ─────────────────────────────────────
QBITTORRENT_URL=https://your-seedbox.example.com/qbittorrent
QBITTORRENT_USER=admin
QBITTORRENT_PASS=your_password
QBITTORRENT_SAVEPATH=/path/on/seedbox/audiobooks

# ── MCP HTTP transport ────────────────────────────────────────────────────────
# Required when running with --transport streamable-http
MCP_AUTH_TOKEN=change_me_to_a_long_random_secret

# Public URL clients use to reach this server (for OAuth metadata / auth)
MCP_SERVER_URL=https://mamarr.example.com

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# Optional TLS (direct HTTPS; omit to terminate TLS at a reverse proxy)
# SSL_CERT_FILE=/path/to/fullchain.pem
# SSL_KEY_FILE=/path/to/privkey.pem

# ── Database ──────────────────────────────────────────────────────────────────
DB_PATH=./data/app.db

# ── Audiobookshelf (library inventory) ────────────────────────────────────────
AUDIOBOOKSHELF_URL=https://abs.example.com
AUDIOBOOKSHELF_TOKEN=your_abs_api_token
# Optional — auto-detects first book library if unset
# AUDIOBOOKSHELF_LIBRARY_ID=

# qBittorrent torrents in this category/tag are treated as owned (pipeline inventory)
QBITTORRENT_INVENTORY_CATEGORY=mamarr
QBITTORRENT_INVENTORY_TAG=audiobooks

# ── Polling ───────────────────────────────────────────────────────────────────
WATCHLIST_POLL_HOURS=6
SERIES_FAVORITES_POLL_HOURS=6
LIBRARY_SYNC_HOURS=12

# ── Discord (optional) ────────────────────────────────────────────────────────
DISCORD_WEBHOOK=
